# Copy to .env and fill in locally. NEVER commit .env.
# The agent layer (Member A) reads these through one OpenAI-compatible connector.

# --- LLM (mock mode replays canned responses; it is a tested feature) ---
LLM_MODE=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-me
LLM_MODEL=llama-3.1-8b-instant

# --- ML sandbox data mode: stub (offline, deterministic) or live (NASA/MAST) ---
DATA_MODE=stub

# Optional overrides
# ORBIT_DATA_DIR=./data
# LLM_MODE=mock
